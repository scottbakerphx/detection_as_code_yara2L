rule gcp_service_account_key_created {
  meta:
    author         = "Scott Baker"
    description     = "A GCP service-account KEY was created. Long-lived SA keys are a top persistence / credential-access vector — alert so it can be confirmed as expected (most workloads should use keyless auth)."
    severity        = "MEDIUM"
    mitre_tactic    = "TA0003 Persistence"
    mitre_technique = "T1098.001 Additional Cloud Credentials"
    platform        = "GCP"
    reference       = "https://cloud.google.com/iam/docs/best-practices-for-managing-service-account-keys"
    yara_l_version  = "2.0"
    status          = "learning"

  events:
    $e.metadata.event_type         = "USER_RESOURCE_CREATION"
    $e.metadata.product_name        = "Google Cloud Platform"
    $e.metadata.product_event_type  = "google.iam.admin.v1.CreateServiceAccountKey"
    $e.principal.user.email_addresses = $actor
    $e.target.resource.name         = $sa

  match:
    $actor, $sa over 1h

  condition:
    $e
}

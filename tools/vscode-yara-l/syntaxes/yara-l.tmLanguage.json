{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "YARA-L",
  "scopeName": "source.yara-l",
  "patterns": [
    { "include": "#comments" },
    { "include": "#rule" },
    { "include": "#sections" },
    { "include": "#keywords" },
    { "include": "#functions" },
    { "include": "#strings" },
    { "include": "#regex" },
    { "include": "#variables" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#meta-keys" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.yara-l", "match": "//.*$" },
        { "name": "comment.block.yara-l", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "rule": {
      "match": "\\b(rule)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.control.rule.yara-l" },
        "2": { "name": "entity.name.function.yara-l" }
      }
    },
    "sections": {
      "name": "keyword.control.section.yara-l",
      "match": "\\b(meta|events|match|condition|outcome|options)\\b(?=\\s*:)"
    },
    "keywords": {
      "name": "keyword.operator.word.yara-l",
      "match": "\\b(and|or|not|nocase|over|before|after|if|any|all)\\b"
    },
    "functions": {
      "name": "support.function.yara-l",
      "match": "\\b(re\\.regex|re\\.capture|strings\\.[a-z_]+|timestamp\\.[a-z_]+|math\\.[a-z_]+|net\\.[a-z_]+|arrays\\.[a-z_]+|group|max|min|sum|count|count_distinct|array_distinct|first|last)\\b"
    },
    "strings": {
      "name": "string.quoted.double.yara-l",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.yara-l", "match": "\\\\." }
      ]
    },
    "regex": {
      "name": "string.regexp.yara-l",
      "begin": "(?<![/\\w])/(?![/*])",
      "end": "/",
      "patterns": [
        { "name": "constant.character.escape.yara-l", "match": "\\\\." }
      ]
    },
    "variables": {
      "patterns": [
        { "name": "variable.other.event.yara-l", "match": "\\$[a-zA-Z_][a-zA-Z0-9_.]*" },
        { "name": "variable.other.count.yara-l", "match": "#[a-zA-Z_][a-zA-Z0-9_.]*" },
        { "name": "variable.other.placeholder.yara-l", "match": "%[a-zA-Z_][a-zA-Z0-9_.]*" },
        { "name": "variable.other.outcome.yara-l", "match": "@[a-zA-Z_][a-zA-Z0-9_.]*" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.duration.yara-l", "match": "\\b\\d+(s|m|h|d)\\b" },
        { "name": "constant.numeric.yara-l", "match": "\\b\\d+(\\.\\d+)?\\b" }
      ]
    },
    "operators": {
      "name": "keyword.operator.yara-l",
      "match": "(!=|<=|>=|=|<|>)"
    },
    "meta-keys": {
      "match": "^\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?==)",
      "captures": {
        "1": { "name": "variable.parameter.meta.yara-l" }
      }
    }
  }
}

{
  "name": "yara-l",
  "displayName": "YARA-L 2.0",
  "description": "Syntax highlighting for YARA-L 2.0 detection rules (Google Security Operations / Chronicle SIEM).",
  "version": "0.1.0",
  "publisher": "scottbakerphx",
  "license": "MIT",
  "author": "Scott Baker",
  "repository": { "type": "git", "url": "https://github.com/scottbakerphx/vscode-yara-l" },
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages"],
  "keywords": ["yara-l", "yaral", "chronicle", "google secops", "siem", "detection engineering", "detection-as-code"],
  "contributes": {
    "languages": [
      {
        "id": "yara-l",
        "aliases": ["YARA-L", "yara-l", "YARA-L 2.0"],
        "extensions": [".yaral", ".yl"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "yara-l",
        "scopeName": "source.yara-l",
        "path": "./syntaxes/yara-l.tmLanguage.json"
      }
    ]
  }
}

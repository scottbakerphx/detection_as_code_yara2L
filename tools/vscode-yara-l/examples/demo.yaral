// demo rule — shows off the YARA-L 2.0 highlighting
rule gcp_service_account_key_created {
  meta:
    author         = "Scott Baker"
    description     = "A GCP service-account key was created — long-lived credential, alert to confirm."
    severity        = "MEDIUM"
    mitre_technique = "T1098.001"
    yara_l_version  = "2.0"

  events:
    $e.metadata.event_type        = "USER_RESOURCE_CREATION"
    $e.metadata.product_event_type = "google.iam.admin.v1.CreateServiceAccountKey"
    $e.principal.user.email_addresses = $actor
    $e.target.resource.name        = /.*serviceAccounts\/.*/ nocase

  match:
    $actor over 1h

  condition:
    #e >= 1
}
